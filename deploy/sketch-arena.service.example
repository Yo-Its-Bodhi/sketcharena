[Unit]
Description=Sketch Arena authoritative game server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=sketcharena
Group=sketcharena
WorkingDirectory=/opt/sketch-arena/current
EnvironmentFile=/etc/sketch-arena/server.env
ExecStartPre=/opt/sketch-arena/runtime/node-lts/bin/node /opt/sketch-arena/current/scripts/migrate-postgres.mjs
ExecStart=/opt/sketch-arena/runtime/node-lts/bin/node /opt/sketch-arena/current/apps/server/dist/index.js
Restart=on-failure
RestartSec=3
TimeoutStopSec=12
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/sketch-arena
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
