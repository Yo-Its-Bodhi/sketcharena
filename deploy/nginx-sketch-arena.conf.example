server {
    listen 443 ssl http2;
    server_name sketcharena.example.com;

    # Supply real certificate paths through the production host/ACME tooling.
    ssl_certificate /etc/letsencrypt/live/sketcharena.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/sketcharena.example.com/privkey.pem;

    root /srv/sketch-arena/apps/web/dist;
    index index.html;
    # Detailed Studio drawings can exceed the default API budget. The app server
    # still applies 256 KB to every non-artwork JSON route.
    client_max_body_size 4m;

    location = /health/live {
        proxy_pass http://127.0.0.1:4100;
        access_log off;
    }

    location = /health/ready {
        proxy_pass http://127.0.0.1:4100;
        access_log off;
    }

    # Metrics are scraped directly from 127.0.0.1:4100 by the host collector.
    # Never proxy the bearer-protected endpoint to the public internet.
    location = /metrics { deny all; }

    location /api/ {
        proxy_pass http://127.0.0.1:4100;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 30s;
    }

    location /socket.io/ {
        proxy_pass http://127.0.0.1:4100;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 75s;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }

    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
}

server {
    listen 80;
    server_name sketcharena.example.com;
    return 301 https://$host$request_uri;
}
