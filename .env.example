# Browser and server
WEB_ORIGIN=http://localhost:5173
PUBLIC_APP_ORIGIN=http://localhost:5173
BIND_HOST=127.0.0.1
PORT=4100
NODE_ENV=production
# Exact Git commit deployed; exposed by health endpoints for release verification.
RELEASE_SHA=development
# Trust only a same-host reverse proxy when resolving client IP rate-limit buckets.
TRUST_PROXY=loopback
ADMIN_API_TOKEN=replace-with-at-least-32-random-characters
# Preferred production form: JSON array of {name,role,tokenHash}; role is viewer, operator, or admin.
# Store SHA-256 hashes only. ADMIN_API_TOKEN remains a single-admin compatibility option.
BACKSTAGE_CREDENTIALS=
# Production must use named principals. Set the migration escape hatch true only briefly and deliberately.
REQUIRE_BACKSTAGE_CREDENTIALS=true
ALLOW_LEGACY_ADMIN_TOKEN=false
# Private scrape credential for the localhost-only Prometheus endpoint.
METRICS_TOKEN=replace-with-a-different-32-character-random-secret

# Development/file-adapter data. Production ignores these and uses PostgreSQL for every durable repository.
ARTWORK_DATA_FILE=/var/lib/sketch-arena/artworks.json
PROGRESSION_DATA_FILE=/var/lib/sketch-arena/progression.json
MINT_DATA_FILE=/var/lib/sketch-arena/mint-lifecycle.json
PROMOTION_DATA_FILE=/var/lib/sketch-arena/promotions.json
REPORT_DATA_FILE=/var/lib/sketch-arena/moderation-reports.json
# Development account fallback only. Production uses PostgreSQL.
ACCOUNT_DATA_FILE=/var/lib/sketch-arena/accounts.json
# Production account database. Required in production; run npm run db:migrate before startup. It replaces ACCOUNT_DATA_FILE for accounts.
DATABASE_URL=
DATABASE_POOL_MAX=10
# WebAuthn must exactly match the public HTTPS host in production. localhost is allowed for development.
PASSKEY_ORIGIN=https://sketch.bodhix.io
PASSKEY_RP_ID=sketch.bodhix.io
PASSKEY_RP_NAME=Sketch Arena
# Separate protected volume. Production pg_dump and development JSON backups both verify SHA-256 manifests.
SKETCH_BACKUP_DIR=/var/backups/sketch-arena

# Panic Archive — leave unset until the reviewed contract is deployed
PANIC_ARCHIVE_ADDRESS=
PANIC_ARCHIVE_CHAIN_ID=9008
PANIC_ARCHIVE_SIGNER_PRIVATE_KEY=
PANIC_ARCHIVE_MINT_PRICE_WEI=
PANIC_ARCHIVE_VOUCHER_SECONDS=900
PANIC_ARCHIVE_CONFIRMATIONS=1

# Shido wallet and receipt verification
SHIDO_RPC_URL=https://evm.shidoscan.net
SHIDO_WALLET_RPC_URLS=https://evm.shidoscan.net,https://9008.rpc.thirdweb.com
SHIDO_CHAIN_NAME=Shido
SHIDO_EXPLORER_URL=https://shidoscan.net

# Private Kubo API plus public gateway. Never expose the Kubo API publicly.
IPFS_API_URL=http://127.0.0.1:5001
IPFS_API_TOKEN=
IPFS_PUBLIC_GATEWAY=https://nftstudio.bodhix.io/ipfs

# Optional only after the real marketplace route is verified. Both placeholders are required.
PANIC_ARCHIVE_MARKETPLACE_TOKEN_URL_TEMPLATE=
